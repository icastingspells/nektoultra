{
   "background": {
      "scripts": [ "background.js" ],
      "service_worker": "background.js"
   },
   "browser_specific_settings": {
      "gecko": {
         "id": "nekto-pro@nekto.pro",
         "strict_min_version": "121.0",
         "data_collection_permissions": {
            "required": [ "none" ]
         }
      }
   },
   "commands": {
      "skip-conversation": {
         "description": "Скип собеседника",
         "suggested_key": {
            "default": "Alt+L"
         }
      },
      "toggle-mic": {
         "description": "Вкл/Выкл микрофон",
         "suggested_key": {
            "default": "Alt+M"
         }
      }
   },
   "content_scripts": [ {
      "js": [ "inject-bootstrap.js" ],
      "matches": [ "https://nekto.me/audiochat*", "https://www.nekto.me/audiochat*" ],
      "run_at": "document_start"
   } ],
   "description": "Авто-скип, изменение голоса, статистика, SoundPad.",
   "host_permissions": [ "https://nekto.me/*", "https://*.nekto.me/*" ],
   "icons": {
      "128": "icon.png"
   },
   "manifest_version": 3,
   "name": "NektoPRO — nekto.me",
   "permissions": [ ],
   "version": "1.3.1",
   "web_accessible_resources": [ {
      "matches": [ "https://nekto.me/*", "https://www.nekto.me/*" ],
      "resources": [ "nekto-pro-inject.js", "vosk-lib.js", "vosk-model-ru.tar.gz" ]
   } ]
}
